@page
@model UsuariosModel
@{
    ViewData["Title"] = "Usuários";
    var fuso = Piersec.Core.Padronizacao.NormalizadorDatas.FusoBrasilia;
}

<h1>Usuários</h1>
<p class="meta">admin: tudo, inclusive usuários · analista: envia arquivos e vê tudo · executivo: só a visão executiva.</p>

@if (Model.Criado is { } criado)
{
    <div class="aviso-forte" role="alert">
        Usuário <strong>@criado.Login</strong> criado. Senha inicial: <code class="senha">@criado.Senha</code><br>
        Entregue à pessoa agora: esta senha NÃO será mostrada de novo. Ela será obrigada a trocá-la no primeiro acesso.
    </div>
}
@if ((Model.Erro ?? Model.ErroCriacao) is { } erro)
{
    <p class="erro" role="alert">@erro</p>
}
@if (Model.Mensagem is not null)
{
    <p class="selo-ok" role="status">@Model.Mensagem</p>
}
@if (Model.AConfirmar is { } alvo)
{
    <section class="card confirmar" role="alertdialog" aria-labelledby="titulo-confirmar">
        <h2 id="titulo-confirmar">Excluir o usuário @alvo.Login (@alvo.Papel)?</h2>
        <p>A pessoa deixa de conseguir entrar, e se estiver com o site aberto perde o acesso no próximo clique.
            Os lotes, relatórios e o histórico da auditoria continuam guardados. Não dá para desfazer: para voltar, crie o usuário de novo.</p>
        <div class="acoes">
            <form method="post" asp-page-handler="Excluir" class="em-linha">
                <input type="hidden" name="login" value="@alvo.Login">
                <button type="submit" class="botao-perigo">Sim, excluir</button>
            </form>
            <a href="/Usuarios">Cancelar</a>
        </div>
    </section>
}

<form method="post" asp-page="/Usuarios" class="cartao">
    <label for="login">Novo usuário (login)</label>
    <input id="login" name="NovoLogin" value="@Model.NovoLogin" required pattern="[a-z0-9._\-]{3,32}" maxlength="32" placeholder="ex.: maria.silva">
    <label for="papel">Papel</label>
    <select id="papel" name="NovoPapel">
        @foreach (var p in Piersec.Core.Seguranca.Papeis.Todos)
        {
            <option value="@p" selected="@(p == Model.NovoPapel)">@p</option>
        }
    </select>
    <button type="submit">Criar usuário</button>
</form>

<h2>Cadastrados</h2>
<table>
    <thead><tr><th>Login</th><th>Papel</th><th>Situação</th><th>Duas etapas</th><th>Criado em</th><th></th></tr></thead>
    <tbody>
        @foreach (var u in Model.Usuarios)
        {
            <tr>
                <td>@u.Login</td>
                <td>@u.Papel</td>
                <td>@(u.BloqueadoAteUtc > Model.Agora ? "bloqueado (muitas tentativas)" : u.TrocarSenha ? "aguardando troca da senha inicial" : "ativo")</td>
                <td>@(u.Tem2fa ? "ativa" : ServicoAutenticacao.Exige2fa(u) ? "pendente (obrigatória)" : "desligada")</td>
                <td>@Formatar.DataHora(u.CriadoEmUtc, fuso)</td>
                <td>
                    @if (string.Equals(u.Login, User.Identity?.Name, StringComparison.OrdinalIgnoreCase))
                    {
                        <span class="meta">você</span>
                    }
                    else
                    {
                        <a href="/Usuarios?excluir=@Uri.EscapeDataString(u.Login)" class="link-perigo">Excluir…</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
