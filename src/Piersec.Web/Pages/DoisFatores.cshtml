@page
@model DoisFatoresModel
@{
    ViewData["Title"] = "Verificação em duas etapas";
    var u = Model.Usuario;
}

<div class="estreito">
    <h1>Verificação em duas etapas</h1>
    <p class="meta">Além da senha, o login pede um código de 6 dígitos que o app do celular gera a cada 30 segundos.
        Quem descobrir a sua senha não entra sem o seu celular. Tudo funciona sem internet: o site e o app calculam o código sozinhos.</p>

    @if (Sessao.PrecisaConfigurar2fa(User) && !u.Tem2fa)
    {
        <p class="aviso-forte" role="alert">Falta concluir o cadastro do seu administrador. Leia o QR code abaixo com o aplicativo de autenticação, digite o código de 6 dígitos e clique em Ativar. Depois, guarde os códigos de recuperação e clique em Já guardei, continuar para liberar as outras páginas.</p>
    }
    @if (Model.Erro is not null)
    {
        <p class="erro" role="alert">@Model.Erro</p>
    }
    @if (Model.Mensagem is not null)
    {
        <p class="selo-ok" role="status">@Model.Mensagem</p>
    }

    @if (Model.CodigosNovos.Count > 0)
    {
        <section class="card" aria-labelledby="titulo-recuperacao">
            <h2 id="titulo-recuperacao">Seus códigos de recuperação</h2>
            <p><strong>Anote ou imprima agora: eles NÃO serão mostrados de novo.</strong> Cada um vale uma vez e serve para entrar
                se você ficar sem o celular. Guarde longe do computador.</p>
            <ul class="codigos-recuperacao">
                @foreach (var c in Model.CodigosNovos)
                {
                    <li><code>@c</code></li>
                }
            </ul>
            <p><a class="botao" href="/">Já guardei, continuar</a></p>
        </section>
    }

    @if (!u.Tem2fa)
    {
        <section class="card">
            <h2>1. Instale um app de autenticação</h2>
            <p>No celular: <strong>Google Authenticator</strong> ou <strong>Microsoft Authenticator</strong> (gratuitos, na loja do celular).</p>
            <h2>2. Leia o QR code com o app</h2>
            <p class="meta">No app: "+" ou "Adicionar conta" → "Ler QR code".</p>
            <div class="qr">@Html.Raw(Model.QrSvg)</div>
            <p class="meta">Não consegue ler? Escolha "Inserir chave de configuração" no app e digite esta chave (tipo: baseado em tempo):</p>
            <p><code class="chave-2fa">@Model.Chave</code></p>
            <h2>3. Digite o código que aparece no app</h2>
            <form method="post" asp-page="/DoisFatores" asp-page-handler="Confirmar" class="formulario">
                <label for="codigo">Código de 6 dígitos</label>
                <input id="codigo" name="Codigo" autocomplete="one-time-code" inputmode="numeric" pattern="[0-9 ]{6,7}" required maxlength="7">
                <button type="submit">Ativar</button>
            </form>
        </section>
    }
    else
    {
        <section class="card">
            <p class="selo-ok">✔ Ativada.</p>
            <p>Códigos de recuperação ainda não usados: <strong>@u.CodigosRecuperacao.Count de @ServicoAutenticacao.QuantidadeCodigosRecuperacao</strong>.</p>

            <h2>Gerar códigos de recuperação novos</h2>
            <p class="meta">Os antigos deixam de valer. Confirme com o código do app.</p>
            <form method="post" asp-page="/DoisFatores" asp-page-handler="NovosCodigos" class="formulario">
                <label for="codigo-novos">Código do app</label>
                <input id="codigo-novos" name="Codigo" autocomplete="one-time-code" inputmode="numeric" pattern="[0-9 ]{6,7}" required maxlength="7">
                <button type="submit">Gerar códigos novos</button>
            </form>

            @if (Model.Obrigatorio)
            {
                <p class="meta">Para administradores a verificação em duas etapas é obrigatória e não pode ser desligada.
                    Celular perdido e sem códigos de recuperação: no computador da plataforma, dê dois cliques em "Esqueci a senha do admin.cmd".</p>
            }
            else
            {
                <h2>Desligar</h2>
                <form method="post" asp-page="/DoisFatores" asp-page-handler="Desativar" class="formulario">
                    <label for="codigo-desligar">Código do app</label>
                    <input id="codigo-desligar" name="Codigo" autocomplete="one-time-code" inputmode="numeric" pattern="[0-9 ]{6,7}" required maxlength="7">
                    <button type="submit" class="botao-perigo">Desligar a verificação em duas etapas</button>
                </form>
            }
        </section>
    }
</div>
