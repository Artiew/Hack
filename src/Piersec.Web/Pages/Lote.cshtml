@page "{id}"
@model LoteModel
@{
    var lote = Model.Lote;
    ViewData["Title"] = "Lote " + lote.Id[..8];
    var fuso = Piersec.Core.Padronizacao.NormalizadorDatas.FusoBrasilia;
    var lacunas = Agrupamentos.Lacunas(lote.Lacunas);
    // Números clicáveis (RG2) só para quem vê a visão técnica; o executivo fica na visão executiva.
    var tecnico = !User.IsInRole(Papeis.Executivo);
    string Ev(FiltroEventos f) => Links.Eventos(lote.Id, f);
    var fontePorEvento = lote.Eventos.ToDictionary(e => e.Id, e => e.Fonte);
    var escolhida = Model.SeveridadeEscolhida;
    var achados = Agrupamentos.CorrelacoesMaisGraves(lote.Correlacoes).Where(c => escolhida is null || c.Severidade == escolhida).Take(20).ToList();
}

<div class="cabecalho-pagina cabecalho-painel">
    <div class="cabecalho-titulo">
        <p class="exec-eyebrow">@if (tecnico) { <a href="/">← Visão geral</a><span aria-hidden="true"> · </span> }Lote @(lote.Id[..8]) · @Formatar.DataHora(lote.CriadoEmUtc, fuso) (Brasília) ·
            @Formatar.Qtd(lote.Arquivos.Count(a => a.Fonte is not null), "arquivo", "arquivos") ·
            @Formatar.Qtd(lote.Eventos.Count, "evento", "eventos")</p>
        <h1>Visão executiva</h1>
    </div>
    @if (lote.Avaliacao is { } avaliacaoTopo) { <p class="cabecalho-frase">@avaliacaoTopo.FraseSituacao</p> }
    @if (GeradorRelatorioHtml.AvisoRevisao(lote, diretoria: !tecnico) is { } avisoRevisao)
    {
        <p class="aviso-forte" role="note">⚠ @avisoRevisao <a href="/Lote/@lote.RevisaoDe">Abrir o lote original →</a></p>
    }
    @if (Model.Revisoes.Count > 0)
    {
        <p class="meta">Revisões deste lote (severidades ajustadas por pessoas):
            @foreach (var r in Model.Revisoes) { <a href="/Lote/@r.Id">@r.Id[..8]</a><span> (@Formatar.Qtd(r.Ajustes, "ajuste", "ajustes"), score @(r.Score is { } sr ? Math.Round(sr).ToString("0") : "—")) </span> }
        </p>
    }
    <div class="acoes">
        @if (lote.Validacao is { } val && val.TudoCerto)
        {
            <span class="selo-ok">✔ @val.Total verificações de consistência, @val.Aprovadas aprovadas</span>
        }
        @if (tecnico)
        {
            <a class="botao" href="/lotes/@lote.Id/relatorio.html" target="_blank" rel="noopener">Abrir relatório (HTML)</a>
            @if (Model.PdfDisponivel)
            {
                <a class="botao botao-secundario" href="/lotes/@lote.Id/relatorio.pdf" download="relatorio-@(lote.Id[..8]).pdf">Baixar PDF</a>
            }
            else
            {
                <span class="erro">O PDF não foi gerado (veja a mensagem no terminal). Abra o HTML e use Imprimir → Salvar como PDF.</span>
            }
            @if (Model.DiretoriaDisponivel)
            {
                <a class="botao botao-secundario" href="/lotes/@lote.Id/relatorio.html?versao=diretoria" target="_blank" rel="noopener">Versão da diretoria</a>
            }
        }
        else if (Model.DiretoriaDisponivel)
        {
            @* O servidor entrega ao executivo sempre a versão da diretoria, mesmo sem ?versao. *@
            <a class="botao" href="/lotes/@lote.Id/relatorio.html" target="_blank" rel="noopener">Abrir relatório (HTML)</a>
            @if (Model.PdfDiretoriaDisponivel)
            {
                <a class="botao botao-secundario" href="/lotes/@lote.Id/relatorio.pdf" download="relatorio-diretoria-@(lote.Id[..8]).pdf">Baixar PDF</a>
            }
            else
            {
                <span class="erro">O PDF não foi gerado. Abra o HTML e use Imprimir → Salvar como PDF.</span>
            }
        }
        else
        {
            <span class="meta">O relatório para a diretoria não existe para este lote (ele foi analisado antes dessa versão existir). Peça à equipe técnica para enviar os arquivos de novo.</span>
        }
    </div>
    @if (lote.Validacao is { } v && !v.TudoCerto)
    {
        <div class="nao-validado" role="alert">
            ✖ RELATÓRIO NÃO VALIDADO: @(v.Total - v.Aprovadas) de @v.Total verificações falharam. Não use estes números para decisão.
            <ul>
                @foreach (var falha in v.Verificacoes.Where(x => !x.Aprovada))
                {
                    <li>@falha.Id — @falha.Descricao: @falha.Detalhe</li>
                }
            </ul>
        </div>
    }
</div>

<partial name="_PainelExecutivo" model="Model" />

@if (tecnico)
{
<details class="tecnico exec-tecnico" id="visao-tecnica" data-etapa aria-labelledby="aba-visao-tecnica" hidden="@(Model.Lote.Avaliacao is not null && Model.SecaoAtual != "visao-tecnica" ? "hidden" : null)" open="@(Model.SecaoAtual == "visao-tecnica" ? "open" : null)"><summary>Abrir visão técnica e evidências</summary>
<h2 id="achados">Achados (correlações)</h2>
<p class="meta">Cada card é uma relação encontrada por uma regra declarada. "Ver mais" abre os eventos que formam o achado, até a linha do arquivo de origem.</p>
<nav class="chips" aria-label="Filtrar achados por severidade">
    <a class="chip" href="/Lote/@lote.Id#achados" aria-current="@(escolhida is null ? "true" : null)">Todos <span class="contagem">@Formatar.Numero(lote.Correlacoes.Count)</span></a>
    @foreach (var sev in SeveridadeExtensoes.DoMaisGrave)
    {
        Severidade? s = sev;
        <a class="chip" href="/Lote/@lote.Id?sev=@sev#achados" aria-current="@(escolhida == sev ? "true" : null)">@Visual.Selo(s) <span class="contagem">@Formatar.Numero(lote.Correlacoes.Count(c => c.Severidade == sev))</span></a>
    }
</nav>
@if (achados.Count == 0)
{
    <p class="vazio">@(escolhida is null ? "Nenhuma correlação encontrada. Veja abaixo o motivo de cada regra." : "Nenhum achado com essa severidade.")</p>
}
else
{
    <div class="cards">
        @foreach (var c in achados)
        {
            Severidade? s = c.Severidade;
            var fontes = c.EventoIds.Select(id => fontePorEvento.GetValueOrDefault(id)).OfType<string>().Distinct().ToList();
            var tags = c.Frameworks.Nist.Select(x => "NIST " + x).Concat(c.Frameworks.Cis.Select(x => "CIS " + x)).Concat(c.Frameworks.Iso.Select(x => "ISO " + x)).Concat(c.Frameworks.Mitre.Select(x => "MITRE " + x));
            <article class="card card-horizontal card-selecionavel" id="@c.Id" tabindex="-1">
                <div class="card-icone @s.ClasseCss()"><svg class="icone" aria-hidden="true"><use href="#i-@s.ClasseCss()"/></svg></div>
                <div class="card-corpo">
                    <p class="card-meta"><code>@c.Id</code> · @(c.Ativos.FirstOrDefault() ?? "—")@(c.Ativos.Count > 1 ? $" e mais {c.Ativos.Count - 1}" : "") · @string.Join(", ", fontes) · @Visual.Selo(s)</p>
                    <h3 class="card-titulo">@c.Titulo</h3>
                    <p class="meta">@c.Justificativa</p>
                    <div class="card-rodape">
                        <span class="tags">@foreach (var t in tags) { <span class="tag">@t</span> }</span>
                        <a href="@Ev(new FiltroEventos { Correlacao = c.Id })">Ver mais →</a>
                    </div>
                </div>
            </article>
        }
    </div>
    @if (lote.Correlacoes.Count(c => escolhida is null || c.Severidade == escolhida) > achados.Count)
    {
        <p class="meta">Mostrando os @achados.Count mais graves. A lista completa está no anexo A do relatório.</p>
    }
}
<h3>Resultado de cada regra</h3>
<table>
    <thead><tr><th>Regra</th><th class="num">Ocorrências</th><th>Observação</th></tr></thead>
    <tbody>
        @foreach (var r in lote.RegrasAvaliadas)
        {
            <tr><td><code>@r.RegraId</code> @r.Nome</td><td class="num">@Formatar.Numero(r.Ocorrencias)</td><td>@r.MotivoSemOcorrencia</td></tr>
        }
    </tbody>
</table>

<h2>Visão técnica</h2>
<p><a class="botao" href="@Ev(new FiltroEventos())">Ver todos os eventos e filtrar →</a>
    <span class="meta">Todo número abaixo é clicável e leva aos eventos que o formam; cada evento mostra o arquivo e a linha de origem.</span></p>

<h3>Eventos por severidade</h3>
<table class="estreita">
    <tbody>
        @foreach (var severidade in SeveridadeExtensoes.DoMaisGrave)
        {
            Severidade? s = severidade;
            <tr><td>@Visual.Selo(s)</td>
                <td class="num"><a href="@Ev(new FiltroEventos { Severidade = severidade.ToString() })">@Formatar.Numero(lote.ContarPorSeveridade(severidade))</a></td></tr>
        }
        <tr><td><span class="sev sev-nenhuma">Sem severidade</span></td>
            <td class="num"><a href="@Ev(new FiltroEventos { Severidade = ConsultaEventos.SemSeveridade })">@Formatar.Numero(lote.ContarPorSeveridade(null))</a></td></tr>
    </tbody>
    <tfoot><tr><th>Total</th><th class="num"><a href="@Ev(new FiltroEventos())">@Formatar.Numero(lote.Eventos.Count)</a></th></tr></tfoot>
</table>

<h3>Por ambiente</h3>
<p class="meta">Cada arquivo é tratado como um ambiente (premissa: os dados não trazem cliente nem ambiente). O consolidado acima continua valendo; aqui dá para olhar um de cada vez.</p>
<table>
    <thead><tr><th>Ambiente</th><th>Fonte</th><th class="num">Eventos</th><th class="num">Máquinas</th><th class="num">Críticos ou altos</th></tr></thead>
    <tbody>
        @foreach (var amb in lote.Eventos.GroupBy(e => (e.Ambiente, e.Fonte)).OrderBy(g => g.Key.Ambiente, StringComparer.Ordinal))
        {
            <tr>
                <td><a href="@Ev(new FiltroEventos { Ambiente = amb.Key.Ambiente })">@amb.Key.Ambiente</a></td>
                <td>@amb.Key.Fonte</td>
                <td class="num">@Formatar.Numero(amb.Count())</td>
                <td class="num">@Formatar.Numero(amb.Select(e => e.Ativo).Distinct().Count())</td>
                <td class="num">@Formatar.Numero(amb.Count(e => e.Severidade >= Severidade.Alta))</td>
            </tr>
        }
    </tbody>
</table>

<h3>Arquivos recebidos</h3>
<table>
    <thead>
        <tr><th>Arquivo</th><th>Tipo reconhecido</th><th class="num">Tamanho</th><th class="num">Lidos</th><th class="num">Rejeitados</th><th class="num">Repetidos</th><th class="num">Lacunas</th><th>SHA-256</th></tr>
    </thead>
    <tbody>
        @foreach (var a in lote.Arquivos)
        {
            <tr>
                <td>@a.Nome</td>
                <td>
                    @if (a.Fonte is not null) { @a.Fonte }
                    else { <span class="erro">Não processado: @a.MotivoNaoProcessado</span> }
                    @foreach (var aviso in a.Avisos)
                    {
                        <div class="meta">Ajuste: @aviso</div>
                    }
                </td>
                <td class="num">@Formatar.Bytes(a.TamanhoBytes)</td>
                <td class="num">@if (a.Fonte is not null) { <a href="@Ev(new FiltroEventos { Arquivo = a.Nome })">@Formatar.Numero(a.RegistrosLidos)</a> } else { @Formatar.Numero(a.RegistrosLidos) }</td>
                <td class="num">@Formatar.Numero(a.RegistrosRejeitados)</td>
                <td class="num">@Formatar.Numero(a.RegistrosRepetidos)</td>
                <td class="num">@Formatar.Numero(a.Lacunas)</td>
                <td><code title="@a.Sha256">@(a.Sha256 is null ? "—" : a.Sha256[..16] + "…")</code></td>
            </tr>
        }
    </tbody>
</table>

<h3>Lacunas (@Formatar.Numero(lote.Lacunas.Count))</h3>
@if (lacunas.Count == 0)
{
    <p class="vazio">Nenhuma lacuna: todos os campos vieram completos e válidos.</p>
}
else
{
    <table>
        <thead><tr><th>Arquivo</th><th>Campo</th><th>Motivo</th><th class="num">Ocorrências</th><th>Linhas (exemplos)</th></tr></thead>
        <tbody>
            @foreach (var g in lacunas)
            {
                <tr>
                    <td>@g.Arquivo</td><td>@g.Campo</td><td>@g.Motivo</td><td class="num">@Formatar.Numero(g.Quantidade)</td>
                    <td>@(g.LinhasExemplo.Count == 0 ? "—" : string.Join(", ", g.LinhasExemplo))</td>
                </tr>
            }
        </tbody>
    </table>
}
</details>
}
@section Scripts {
    <script src="~/js/executivo.js" asp-append-version="true" defer></script>
}