@page "{id}"
@model LoteModel
@{
    var lote = Model.Lote;
    ViewData["Title"] = "Lote " + lote.Id[..8];
    var fuso = Piersec.Core.Padronizacao.NormalizadorDatas.FusoBrasilia;
    var correlacoes = Agrupamentos.CorrelacoesMaisGraves(lote.Correlacoes).Take(20).ToList();
    var lacunas = Agrupamentos.Lacunas(lote.Lacunas);
}

<p><a href="/">← Enviar outro lote</a></p>
<h1>Lote @(lote.Id[..8])</h1>
<p class="meta">Processado em @Formatar.DataHora(lote.CriadoEmUtc, fuso) (horário de Brasília).</p>

@if (lote.Validacao is { } val)
{
    if (val.TudoCerto)
    {
        <p class="selo-ok">✔ @val.Total verificações de consistência, @val.Aprovadas aprovadas</p>
    }
    else
    {
        <div class="nao-validado" role="alert">
            ✖ RELATÓRIO NÃO VALIDADO: @(val.Total - val.Aprovadas) de @val.Total verificações falharam. Não use estes números para decisão.
            <ul>
                @foreach (var falha in val.Verificacoes.Where(x => !x.Aprovada))
                {
                    <li>@falha.Id — @falha.Descricao: @falha.Detalhe</li>
                }
            </ul>
        </div>
    }
}

<div class="acoes">
    <a class="botao" href="/lotes/@lote.Id/relatorio.html" target="_blank" rel="noopener">Abrir relatório (HTML)</a>
    @if (Model.PdfDisponivel)
    {
        <a class="botao" href="/lotes/@lote.Id/relatorio.pdf" download="relatorio-@(lote.Id[..8]).pdf">Baixar PDF</a>
    }
    else
    {
        <span class="erro">O PDF não foi gerado (veja a mensagem no terminal). Abra o HTML e use Imprimir → Salvar como PDF.</span>
    }
</div>

@if (lote.Avaliacao is { } av)
{
    var s = av.Score;
    <section class="cartao resumo">
        <div class="score">
            <span class="grande">@(s.Valor is { } v ? Math.Round(v).ToString("0") : "—")</span><span class="meta"> de 100</span>
            <div><strong>Risco @s.Faixa.ToLowerInvariant()</strong> <span class="meta">(100 = risco máximo · confiança @s.Confianca)</span></div>
        </div>
        <div>
            @if (Model.AvisoConfianca is not null)
            {
                <p class="aviso-forte" role="alert">⚠ @Model.AvisoConfianca</p>
            }
            <p><strong>@av.FraseSituacao</strong></p>
            @if (lote.Comparacao is { } c)
            {
                <p class="meta">Antes: @Math.Round(c.ScoreAnterior).ToString("0") (@(c.Diferenca > 0 ? "+" : "")@Math.Round(c.Diferenca).ToString("0") ponto(s)) — @c.Motivo.</p>
            }
            @if (av.FraseUmaCoisa is not null)
            {
                <p>Se fizer só uma coisa: @av.FraseUmaCoisa</p>
            }
        </div>
    </section>

    @foreach (var avisoAmbiente in lote.FontesAusentes.Concat(lote.AvisosAmbiente))
    {
        <p class="aviso-forte" role="alert">⚠ @avisoAmbiente</p>
    }

    <h2>O que é mais grave</h2>
    <ol>
        @foreach (var r in av.Riscos)
        {
            <li><strong>@r.Titulo.</strong> @r.OQueE <em>@r.ComoResolver</em></li>
        }
    </ol>

    @if (lote.Servicos.Count > 0)
    {
        <h2>Serviços da empresa</h2>
        <p>
            @if (GeradorRelatorioHtml.FrasePrejuizo(lote) is { } prejuizo)
            {
                <strong>Em risco: @GeradorRelatorioHtml.ServicosEmRisco(lote, int.MaxValue).</strong> @prejuizo
            }
            else
            {
                <strong>Nenhum serviço está em risco elevado ou pior</strong> <span>nas fontes analisadas.</span>
            }
        </p>
        <table>
            <thead><tr><th>Serviço</th><th>Situação</th><th class="num">Máquinas com falha grave</th><th class="num">Alertas que merecem análise</th><th>Prejuízo se for atingido</th></tr></thead>
            <tbody>
                @foreach (var servico in lote.Servicos)
                {
                    <tr>
                        <td><strong>@servico.Nome</strong></td>
                        <td>@if (servico.EmRisco) { <strong>@servico.Faixa</strong> } else { @servico.Faixa }</td>
                        <td class="num">@Formatar.Numero(servico.MaquinasComFalhaGrave) de @Formatar.Numero(servico.Maquinas)</td>
                        <td class="num">@Formatar.Numero(servico.AlertasRelevantes)</td>
                        <td>@(servico.Impacto is { } i ? Formatar.FaixaDinheiro(i.Minimo, i.Maximo) : "não estimado")</td>
                    </tr>
                }
            </tbody>
        </table>
        <p class="meta">Premissa: os dados não dizem que serviço cada máquina atende; a equipe ligou pelo nome e pelo tipo da máquina.
            Os valores são faixas de referência deste exercício, não números da empresa (detalhes na seção 2 do relatório).</p>
    }

    @if (Model.FraseAchados is { } fraseAchados)
    {
        <h2>@GeradorRelatorioHtml.TituloAchados(av)</h2>
        <p><strong>@fraseAchados</strong></p>
        <ol>
            @foreach (var achado in av.AchadosPrincipais)
            {
                <li>@achado.Texto</li>
            }
        </ol>
    }

    <h2>O que fazer agora</h2>
    <table>
        <thead><tr><th>#</th><th>Ação</th><th>Resultado esperado</th><th>Esforço</th><th>Prazo</th></tr></thead>
        <tbody>
            @foreach (var acao in av.Acoes)
            {
                <tr>
                    <td class="num">@acao.Ordem</td>
                    <td><strong>@acao.Titulo</strong><div class="meta">@acao.Quadrante</div></td>
                    <td>@acao.Impacto</td>
                    <td>@(acao.Esforco switch { Nivel.Alto => "alto", Nivel.Medio => "médio", _ => "baixo" })</td>
                    <td>até @acao.PrazoDias dias</td>
                </tr>
            }
        </tbody>
    </table>
}

@if (lote.Operacao is { } op)
{
    <h2>O que a plataforma fez sozinha</h2>
    <section class="cartao painel-op">
        <div><span class="rotulo">@(op.Ensaio ? "Faria sozinha" : "Feito sozinho")</span><span class="valor">@op.Sozinho</span><span class="meta">chamados simulados, dentro das travas</span></div>
        <div><span class="rotulo">Aguardando aprovação</span><span class="valor">@op.AguardandoAprovacao</span><span class="meta">uma pessoa decide na tela Automação</span></div>
        <div><span class="rotulo">Fechados sozinhos</span><span class="valor">@op.Contar(Piersec.Core.Operacao.ResultadoItem.FechouSozinho)</span><span class="meta">o problema sumiu neste lote</span></div>
        <div><span class="rotulo">Já existiam</span><span class="valor">@op.Contar(Piersec.Core.Operacao.ResultadoItem.JaExistia)</span><span class="meta">mesmo problema: não duplicou</span></div>
    </section>
    <p>Nível de autonomia @op.Nivel: @op.DescricaoNivel.@(op.Ensaio ? " MODO ENSAIO: nada foi gravado." : "")
        @(op.LoteValidado ? "" : " Este lote não passou nas verificações: nada foi feito sozinho.")
        <a href="/Automacao">Ver fila de aprovação, chamados e log de decisão →</a></p>
}

@if (!User.IsInRole(Papeis.Executivo))
{
<div class="tecnico">
<h2>Eventos por severidade</h2>
<table class="estreita">
    <tbody>
        @foreach (var severidade in SeveridadeExtensoes.DoMaisGrave)
        {
            Severidade? s = severidade;
            <tr><td><span class="sev @s.ClasseCss()"><span aria-hidden="true">@s.Simbolo()</span> @s.Nome()</span></td><td class="num">@Formatar.Numero(lote.ContarPorSeveridade(severidade))</td></tr>
        }
        <tr><td><span class="sev sev-nenhuma">Sem severidade</span></td><td class="num">@Formatar.Numero(lote.ContarPorSeveridade(null))</td></tr>
    </tbody>
    <tfoot><tr><th>Total</th><th class="num">@Formatar.Numero(lote.Eventos.Count)</th></tr></tfoot>
</table>

<h2>Correlações (@Formatar.Numero(lote.Correlacoes.Count))</h2>
@if (correlacoes.Count == 0)
{
    <p class="vazio">Nenhuma correlação encontrada. Veja abaixo o motivo de cada regra.</p>
}
else
{
    <p class="meta">As @correlacoes.Count mais graves. A lista completa e as justificativas estão no relatório.</p>
    <table>
        <thead><tr><th>Id</th><th>Severidade</th><th>O que foi encontrado</th><th class="num">Máquinas</th><th class="num">Eventos</th></tr></thead>
        <tbody>
            @foreach (var c in correlacoes)
            {
                Severidade? s = c.Severidade;
                <tr>
                    <td><code>@c.Id</code></td>
                    <td><span class="sev @s.ClasseCss()"><span aria-hidden="true">@s.Simbolo()</span> @s.Nome()</span></td>
                    <td title="@c.Justificativa">@c.Titulo</td>
                    <td class="num">@Formatar.Numero(c.Ativos.Count)</td>
                    <td class="num">@Formatar.Numero(c.EventoIds.Count)</td>
                </tr>
            }
        </tbody>
    </table>
}
<h3>Resultado de cada regra</h3>
<table>
    <thead><tr><th>Regra</th><th class="num">Ocorrências</th><th>Observação</th></tr></thead>
    <tbody>
        @foreach (var r in lote.RegrasAvaliadas)
        {
            <tr><td><code>@r.RegraId</code> @r.Nome</td><td class="num">@Formatar.Numero(r.Ocorrencias)</td><td>@r.MotivoSemOcorrencia</td></tr>
        }
    </tbody>
</table>

<h2>Arquivos recebidos</h2>
<table>
    <thead>
        <tr><th>Arquivo</th><th>Tipo reconhecido</th><th class="num">Tamanho</th><th class="num">Lidos</th><th class="num">Rejeitados</th><th class="num">Repetidos</th><th class="num">Lacunas</th><th>SHA-256</th></tr>
    </thead>
    <tbody>
        @foreach (var a in lote.Arquivos)
        {
            <tr>
                <td>@a.Nome</td>
                <td>
                    @if (a.Fonte is not null) { @a.Fonte }
                    else { <span class="erro">Não processado: @a.MotivoNaoProcessado</span> }
                    @foreach (var aviso in a.Avisos)
                    {
                        <div class="meta">Ajuste: @aviso</div>
                    }
                </td>
                <td class="num">@Formatar.Bytes(a.TamanhoBytes)</td>
                <td class="num">@Formatar.Numero(a.RegistrosLidos)</td>
                <td class="num">@Formatar.Numero(a.RegistrosRejeitados)</td>
                <td class="num">@Formatar.Numero(a.RegistrosRepetidos)</td>
                <td class="num">@Formatar.Numero(a.Lacunas)</td>
                <td><code title="@a.Sha256">@(a.Sha256 is null ? "—" : a.Sha256[..16] + "…")</code></td>
            </tr>
        }
    </tbody>
</table>

<h2>Lacunas (@Formatar.Numero(lote.Lacunas.Count))</h2>
@if (lacunas.Count == 0)
{
    <p class="vazio">Nenhuma lacuna: todos os campos vieram completos e válidos.</p>
}
else
{
    <table>
        <thead><tr><th>Arquivo</th><th>Campo</th><th>Motivo</th><th class="num">Ocorrências</th><th>Linhas (exemplos)</th></tr></thead>
        <tbody>
            @foreach (var g in lacunas)
            {
                <tr>
                    <td>@g.Arquivo</td><td>@g.Campo</td><td>@g.Motivo</td><td class="num">@Formatar.Numero(g.Quantidade)</td>
                    <td>@(g.LinhasExemplo.Count == 0 ? "—" : string.Join(", ", g.LinhasExemplo))</td>
                </tr>
            }
        </tbody>
    </table>
}
</div>
}
