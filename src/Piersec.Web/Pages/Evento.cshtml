@page "/Lote/{id}/Evento/{eventoId}"
@model EventoModel
@using Piersec.Core.Consulta
@{
    var lote = Model.Lote;
    var e = Model.Evento;
    ViewData["Title"] = e.Id;
    var fuso = Piersec.Core.Padronizacao.NormalizadorDatas.FusoBrasilia;
}

<p><a href="/Lote/@lote.Id/Eventos">← Todos os eventos do lote @lote.Id[..8]</a></p>
<h1>@e.Id · @Visual.Selo(e.Severidade)</h1>
<p><strong>@e.Descricao</strong></p>

<section class="cartao origem">
    <h2>De onde veio</h2>
    <p>Arquivo <code>@e.Evidencia.Arquivo</code>, <strong>linha @e.Evidencia.Linha</strong>
        (contando o cabeçalho como linha 1).</p>
    <p class="meta">Impressão digital do arquivo (SHA-256): <code>@e.Evidencia.Sha256Arquivo</code>.
        Se o arquivo que você tem der a mesma impressão digital, a linha @e.Evidencia.Linha dele é exatamente a que gerou este evento.</p>
    <p class="meta">A plataforma não guarda a linha original do CSV (só os campos que usa), para guardar o mínimo de dados (LGPD).
        Para ver a linha como veio, abra o arquivo nessa linha.</p>
</section>

<h2>Por que esta severidade</h2>
<p>@(e.Justificativa ?? "Sem justificativa.")</p>
<p class="meta">Como veio na fonte: @(e.SeveridadeOrigem ?? "não informada")@(e.Cvss is { } cvss ? $" · nota CVSS {cvss.ToString("0.0", Formatar.PtBr)}" : "")@(e.NivelOrigem is { } nivel ? $" · nível {nivel}" : "")</p>
@if (Model.Ajuste is { } aj)
{
    <p class="aviso-forte">Severidade ajustada por @aj.Usuario (de @aj.De.Nome() para @aj.Para.Nome()). A plataforma tinha dito: “@aj.JustificativaOriginal”</p>
}

<details class="cartao discordar" open="@(Model.Erro is not null)">
    <summary>Discordar da severidade</summary>
    <p class="meta">Se você sabe algo que os dados não mostram (ex.: a máquina está desligada, isolada ou o serviço não usa esse programa),
        escolha a severidade correta e explique. A plataforma cria uma <strong>revisão</strong> do lote com o score, o plano e o relatório
        recalculados. O lote original não muda, e o seu motivo aparece no relatório (anexo I) e na auditoria.</p>
    @if (Model.Erro is not null)
    {
        <p class="erro" role="alert">@Model.Erro</p>
    }
    <form method="post" asp-page-handler="Discordar" class="formulario">
        <label for="nova">Severidade correta</label>
        <select id="nova" name="NovaSeveridade" required>
            <option value="">escolha…</option>
            @foreach (var sev in SeveridadeExtensoes.DoMaisGrave.Where(s => s != e.Severidade))
            {
                Severidade? s = sev;
                <option value="@sev">@s.Nome()</option>
            }
        </select>
        <label for="motivo">Por quê? (obrigatório, fica registrado)</label>
        <textarea id="motivo" name="Motivo" required minlength="@CicloAnalise.TamanhoMinimoMotivo" maxlength="@Piersec.Core.Operacao.ServicoOperacao.TamanhoMaximoMotivo" rows="3">@Model.Motivo</textarea>
        <button type="submit">Criar revisão com esta severidade</button>
    </form>
</details>

<h2>O que a plataforma leu</h2>
<table class="estreita-media">
    <tbody>
        <tr><th>Fonte</th><td>@e.Fonte</td></tr>
        <tr><th>Tipo</th><td>@e.Tipo</td></tr>
        <tr><th>Ambiente</th><td>@e.Ambiente <span class="meta">(premissa: o nome do arquivo)</span></td></tr>
        <tr><th>Máquina</th><td><a href="@Links.Eventos(lote.Id, new FiltroEventos { Ativo = e.Ativo })">@e.Ativo</a> <span class="meta">(@Model.Regras.Ativos.Tipo(e.TipoAtivo).Singular)</span></td></tr>
        <tr><th>Serviço</th><td>@if (Model.Servico is { } s) { <a href="@Links.Eventos(lote.Id, new FiltroEventos { Servico = s.Id })">@s.Nome</a> <span class="meta">(situação @s.Faixa.ToLowerInvariant(); premissa da equipe)</span> } else { <span>—</span> }</td></tr>
        <tr><th>Quando</th><td>@if (e.DataUtc is null) { <span>não informada pela fonte</span> } else { @Formatar.DataHora(e.DataUtc, fuso) <span class="meta">(horário de Brasília)</span> }</td></tr>
        @if (e.Cve is not null) { <tr><th>Falha (CVE)</th><td>@e.Cve</td></tr> }
        @if (e.Pacote is not null) { <tr><th>Programa</th><td><a href="@Links.Eventos(lote.Id, new FiltroEventos { Texto = e.Pacote })">@e.Pacote</a> @e.VersaoPacote</td></tr> }
        @if (e.SistemaOperacional is not null) { <tr><th>Sistema</th><td>@e.SistemaOperacional</td></tr> }
        @if (e.RegraOrigem is not null) { <tr><th>Regra do alerta</th><td><a href="@Links.Eventos(lote.Id, new FiltroEventos { Regra = e.RegraOrigem })">@e.RegraOrigem</a></td></tr> }
        @if (e.UsuarioAnonimo is not null) { <tr><th>Usuário (anonimizado)</th><td><code>@e.UsuarioAnonimo</code></td></tr> }
        @if (e.Detalhe is not null) { <tr><th>Detalhe da fonte</th><td>@e.Detalhe</td></tr> }
    </tbody>
</table>

<h2>Correlações em que aparece (@Model.Correlacoes.Count)</h2>
@if (Model.Correlacoes.Count == 0)
{
    <p class="vazio">Este evento não entrou em nenhuma correlação.</p>
}
else
{
    <ul>
        @foreach (var c in Model.Correlacoes)
        {
            <li><a href="@Links.Eventos(lote.Id, new FiltroEventos { Correlacao = c.Id })"><code>@c.Id</code></a> @c.Titulo
                <div class="meta">@c.Justificativa</div></li>
        }
    </ul>
}
