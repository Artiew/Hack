@page
@model IndexModel
@{
    ViewData["Title"] = "Enviar arquivos";
    var fuso = Piersec.Core.Padronizacao.NormalizadorDatas.FusoBrasilia;
}

@if (Sessao.PodeEnviar(User))
{
    <h1>Enviar arquivos (.csv)</h1>
    <p class="meta">
        Os arquivos enviados juntos formam um <strong>lote</strong> e são analisados em conjunto, gerando um único relatório.
        Até @ProcessadorLote.MaximoArquivos arquivos de no máximo @Formatar.Bytes(ProcessadorLote.TamanhoMaximoBytes) cada.
    </p>

    @if (Model.Erro is not null)
    {
        <p class="erro" role="alert">@Model.Erro</p>
    }

    <form method="post" enctype="multipart/form-data" class="cartao">
        <label for="arquivos">Escolha um ou mais arquivos CSV</label>
        <input id="arquivos" name="arquivos" type="file" accept=".csv,text/csv" multiple required>
        <button type="submit">Enviar e analisar</button>
    </form>
}
else
{
    <h1>Relatórios</h1>
    <p class="meta">Escolha um lote para ver o resumo e abrir o relatório.</p>
}

<h2>Lotes anteriores</h2>
@if (Model.Lotes.Count == 0)
{
    <p class="vazio">Nenhum lote ainda. Envie os arquivos acima para gerar o primeiro relatório.</p>
}
else
{
    <table>
        <thead>
            <tr><th>Data</th><th class="num">Score</th><th>Validação</th><th class="num">Arquivos</th><th class="num">Eventos</th><th class="num">Correlações</th><th class="num">Lacunas</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var lote in Model.Lotes)
            {
                <tr>
                    <td>@Formatar.DataHora(lote.CriadoEmUtc, fuso)</td>
                    <td class="num">@(lote.Score is { } sc ? Math.Round(sc).ToString("0") : "—")</td>
                    <td>@(lote.VerificacoesTotal is null ? "—" : lote.Validado ? $"✔ {lote.VerificacoesAprovadas}/{lote.VerificacoesTotal}" : $"✖ {lote.VerificacoesAprovadas}/{lote.VerificacoesTotal}")</td>
                    <td class="num">@lote.Arquivos</td>
                    <td class="num">@Formatar.Numero(lote.Eventos)</td>
                    <td class="num">@Formatar.Numero(lote.Correlacoes)</td>
                    <td class="num">@Formatar.Numero(lote.Lacunas)</td>
                    <td><a asp-page="/Lote" asp-route-id="@lote.Id">Abrir</a></td>
                </tr>
            }
        </tbody>
    </table>
}
