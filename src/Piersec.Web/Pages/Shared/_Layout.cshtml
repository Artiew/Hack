<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"] · Piersec</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
</head>
<body>
    <header class="topo">
        <a class="marca" href="/">Plataforma de risco</a>
        <span class="etiqueta">Protótipo · dados sintéticos</span>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <nav class="menu">
                <a href="/">Lotes</a>
                <a href="/Automacao">Automação</a>
                @if (User.IsInRole(Papeis.Admin))
                {
                    <a href="/Usuarios">Usuários</a>
                    <a href="/Auditoria">Auditoria</a>
                }
                <a href="/TrocarSenha">Trocar senha</a>
                <span class="meta">@User.Identity.Name (@(User.IsInRole(Papeis.Admin) ? Papeis.Admin : User.IsInRole(Papeis.Analista) ? Papeis.Analista : Papeis.Executivo))</span>
                <form method="post" action="/Sair" class="em-linha">
                    <button type="submit" class="botao-discreto">Sair</button>
                </form>
            </nav>
        }
    </header>
    <main class="conteudo">
        @RenderBody()
    </main>
</body>
</html>
